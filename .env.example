# 应用
TALENT_AGENT_ENVIRONMENT=local
TALENT_AGENT_DEBUG=false
TALENT_AGENT_ENABLE_AGENT=true

# 数据库：支持 MySQL、PostgreSQL；测试可使用 SQLite。
TALENT_AGENT_DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/talent_agent?charset=utf8mb4
TALENT_AGENT_DATABASE_ECHO=false

# 内部大模型：密钥只能通过环境变量或密钥服务注入。
TALENT_AGENT_LLM_MODEL=deepseek-v3
TALENT_AGENT_LLM_BASE_URL=https://example-llm.internal/v1
TALENT_AGENT_LLM_API_KEY=
TALENT_AGENT_LLM_TIMEOUT_SECONDS=30

# 多模态匹配独立开关与视觉模型。使用同一网关也需显式配置视觉凭据。
TALENT_AGENT_ENABLE_MATCHING=false
TALENT_AGENT_VISION_MODEL=deepseek-flash
TALENT_AGENT_VISION_BASE_URL=https://api.deepseek.com
TALENT_AGENT_VISION_API_KEY=
TALENT_AGENT_VISION_TIMEOUT_SECONDS=30
TALENT_AGENT_IMAGE_MAX_BYTES=10485760
TALENT_AGENT_IMAGE_MAX_PIXELS=20000000
TALENT_AGENT_MATCHING_TARGET=10
TALENT_AGENT_MATCHING_MAX_PAGES=5
TALENT_AGENT_MATCHING_MAX_CANDIDATES=50
TALENT_AGENT_MATCHING_BATCH_SIZE=5
TALENT_AGENT_MATCHING_MAX_MODEL_ATTEMPTS=20
TALENT_AGENT_MATCHING_DEADLINE_SECONDS=120
TALENT_AGENT_MATCHING_MAX_ROUNDS=10
TALENT_AGENT_MATCHING_MAX_TOTAL_CANDIDATES=500
TALENT_AGENT_MATCHING_MAX_SNAPSHOT_BYTES=10485760
TALENT_AGENT_MATCHING_MAX_ACTIVE_TASKS=100
TALENT_AGENT_MATCHING_MAX_INPUT_CALLS=4

# 招聘系统人才库接口；登录 Cookie 必须来自每次用户请求，不能写入此文件。
TALENT_AGENT_JAVA_BASE_URL=https://zhaopin.netease.com
TALENT_AGENT_JAVA_SERVICE_TOKEN=
TALENT_AGENT_JAVA_RESOLVE_PATH=/internal/agent/search/resolve-entities
TALENT_AGENT_JAVA_SEARCH_PATH=/api/eTalent/talent/list/page
TALENT_AGENT_JAVA_CITY_OPTIONS_PATH=/api/eTalent/option/city
TALENT_AGENT_JAVA_TIMEOUT_SECONDS=10
TALENT_AGENT_JAVA_USER_COOKIE_NAME=authOpenIdToken
TALENT_AGENT_JAVA_COOKIE_ALLOWED_HOST=zhaopin.netease.com
TALENT_AGENT_JAVA_REQUIRES_USER_COOKIE=true
TALENT_AGENT_JAVA_DIRECT_BROWSER_API=true

# V1 搜索策略由服务端固定，不能由用户或模型修改。
TALENT_AGENT_DEFAULT_PAGE_SIZE=10
TALENT_AGENT_DEFAULT_SORT_TYPE=1
TALENT_AGENT_DEFAULT_KEYWORDS_MATCH_TYPE=ALL
TALENT_AGENT_DEFAULT_IN_FLOW=true
TALENT_AGENT_DEFAULT_HIDE_CLUE=true
